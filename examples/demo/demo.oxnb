          "value": "http://www.w3.org/2001/XMLSchema#string"
         },
         "language": "",
         "termType": "Literal",
         "value": "Bob Stone"
        },
        {
         "datatype": {
          "termType": "NamedNode",
          "value": "http://www.w3.org/2001/XMLSchema#integer"
         },
         "language": "",
         "termType": "Literal",
         "value": "90000"
        }
       ],
       [
        {
         "termType": "NamedNode",
         "value": "https://example.org/cyd"
        },
        {
         "datatype": {
          "termType": "NamedNode",
          "value": "http://www.w3.org/2001/XMLSchema#string"
         },
         "language": "",
         "termType": "Literal",
         "value": "Cyd Park"
        },
        {
         "datatype": {
          "termType": "NamedNode",
          "value": "http://www.w3.org/2001/XMLSchema#integer"
